# SnpEff mínimo do curso: um único genoma (mtDNA rCRS) construído localmente.
# Construir uma vez (offline):
#   (o notebook monta data/chrM_rCRS/ e roda snpEff build uma vez)
data.dir = ./data/

chrM_rCRS.genome : Homo sapiens mtDNA rCRS NC_012920.1 (minicurso)
# SnpEff remove o prefixo "chr" ao normalizar nomes: a chave efetiva é "M".
chrM_rCRS.M.codonTable : Vertebrate_Mitochondrial
chrM_rCRS.MT.codonTable : Vertebrate_Mitochondrial
chrM_rCRS.chrM.codonTable : Vertebrate_Mitochondrial

# Tabelas de código genético (copiadas do snpEff.config oficial, v5.x)
